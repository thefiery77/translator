# ── LLM ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Model for faithful/creative/contextual generators (expensive, high quality)
OPENAI_MODEL_FAITHFUL=gpt-4o
OPENAI_MODEL_CREATIVE=gpt-4o
OPENAI_MODEL_CONTEXTUAL=gpt-4o
# Model for style critic (can be cheaper)
OPENAI_MODEL_CRITIC=gpt-4o-mini
# Model for patch synthesis (needs quality)
OPENAI_MODEL_PATCH=gpt-4o

# ── Databases (cloud) ────────────────────────────────
# MongoDB Atlas — https://cloud.mongodb.com → Connect → Drivers
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=translator

# Qdrant Cloud — https://cloud.qdrant.io → Cluster → API Keys
QDRANT_URL=https://<cluster-id>.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=<qdrant-api-key>

# Redis Cloud — https://app.redislabs.com → Database → Configuration
# Formato: rediss://<user>:<password>@<host>:<port>
REDIS_URL=rediss://default:<password>@<host>:<port>

# ── Chunking ─────────────────────────────────────────
CHUNK_TARGET_TOKENS=2048
CHUNK_MAX_TOKENS=4096
CHUNK_OVERLAP_TOKENS=128

# ── Critics ──────────────────────────────────────────
# Style critic confidence above this → accept best candidate directly
STYLE_CRITIC_CONFIDENCE_THRESHOLD=0.75
# Deterministic critic: max non-critical violations before escalation
DETERMINISTIC_CRITIC_MAX_VIOLATIONS=3

# ── Workflow ─────────────────────────────────────────
MAX_PATCH_ATTEMPTS=2

# ── Observability (Langfuse) ─────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
